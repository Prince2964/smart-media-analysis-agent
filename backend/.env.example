# Copy to backend/.env and fill the four key-mode secrets at the bottom.
# Never commit the real .env. API-key mode needs no az login or application identity.

# Azure processing
PROCESSING_MODE=azure-media
STORAGE_MODE=azure

# Blob Storage
AZURE_STORAGE_ACCOUNT_URL=https://mediaanylyzer13.blob.core.windows.net/
AZURE_STORAGE_CONTAINER=media-uploads

# Content Understanding
CONTENT_UNDERSTANDING_ENDPOINT=https://media-analyzer-13-resource.services.ai.azure.com/

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://media-analyzer.search.windows.net
AZURE_SEARCH_INDEX=media-passages-v1

# Azure OpenAI
REPORT_MODEL_ENDPOINT=https://media-analyzer-13-resource.openai.azure.com/
REPORT_MODEL_DEPLOYMENT=gpt-5-mini

# Foundry agents
FOUNDRY_PROJECT_ENDPOINT=https://media-analyzer-13-resource.services.ai.azure.com/api/projects/media-analyzer-13
FOUNDRY_AGENT_NAME=smart-media-analysis-agent
FOUNDRY_AGENT_VERSION=2
FOUNDRY_WEB_AGENT_VERSION=3

# Authentication mode. Tenant/client fields are unused in api-key mode.
AZURE_AUTH_MODE=api-key
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Key-mode credentials. Fill privately; do not commit real values.
AZURE_STORAGE_CONNECTION_STRING=
CONTENT_UNDERSTANDING_KEY=
REPORT_MODEL_KEY=
AZURE_SEARCH_KEY=
