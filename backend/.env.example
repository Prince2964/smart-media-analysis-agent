# PRIVATE BACKEND CONFIGURATION - do not upload this file to GitHub.
# Azure endpoints and agent versions below are already configured.
# To run on another laptop WITHOUT az login:
# 1. Fill AZURE_TENANT_ID, AZURE_CLIENT_ID and AZURE_CLIENT_SECRET below.
# 2. Grant that application access to the configured Azure resources.
# 3. Change AZURE_AUTH_MODE from cli to service-principal.
# 4. Restart the backend. The laptop network must be allowed by Azure firewalls.
# This example selects service-principal; fill its three fields before starting.


# Azure processing
PROCESSING_MODE=azure-media
STORAGE_MODE=azure

# Blob Storage
AZURE_STORAGE_ACCOUNT_URL=https://mediaanylyzer13.blob.core.windows.net/
AZURE_STORAGE_CONTAINER=media-uploads

# Content Understanding
CONTENT_UNDERSTANDING_ENDPOINT=https://media-analyzer-13-resource.services.ai.azure.com/

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://media-analyzer.search.windows.net
AZURE_SEARCH_INDEX=media-passages-v1

# Azure OpenAI
REPORT_MODEL_ENDPOINT=https://media-analyzer-13-resource.openai.azure.com/
REPORT_MODEL_DEPLOYMENT=gpt-5-mini

# Foundry agents
FOUNDRY_PROJECT_ENDPOINT=https://media-analyzer-13-resource.services.ai.azure.com/api/projects/media-analyzer-13
FOUNDRY_AGENT_NAME=smart-media-analysis-agent
FOUNDRY_AGENT_VERSION=2
FOUNDRY_WEB_AGENT_VERSION=3

# Application credentials: enter locally, never commit real values.
AZURE_AUTH_MODE=service-principal
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
